{
  "name": "nexus-launcher",
  "productName": "Nexus Launcher",
  "description": "Cinematic Windows game library and launcher",
  "author": "Nexus Launcher",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "main": "backend/main.mjs",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/library-registry.test.mjs tests/steamgrid-secret.test.mjs tests/store-discovery.test.mjs tests/media-cache.test.mjs tests/game-session.test.mjs tests/catalog-media.test.mjs tests/steam-achievements.test.mjs tests/steam-openid.test.mjs tests/store-accounts.test.mjs && vitest run",
    "qa:capture": "node scripts/capture-suite.mjs",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "qa:local": "node scripts/app-qa-local.mjs",
    "qa:reliability": "node scripts/qa-reliability.mjs",
    "qa:focus": "node scripts/focus-qa.mjs",
    "qa:performance": "node scripts/performance-qa.mjs",
    "desktop": "npm run build && electron .",
    "pack:win": "npm run build && electron-builder --win dir --x64",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.0",
    "@rive-app/react-webgl2": "^4.34.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "5.0.4",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "i18next": "^26.4.2",
    "motion": "^13.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^17.0.14",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0",
    "vite": "6.4.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.0",
    "motion-ai": "^14.1.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "io.nexus.launcher",
    "productName": "Nexus Launcher",
    "artifactName": "Nexus-Launcher-${version}-${arch}.${ext}",
    "asar": true,
    "files": [
      "dist/client/**/*",
      "backend/**/*",
      "vite.config.mjs",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "public/assets/brand/nexus-mark.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Nexus-Launcher-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexus Launcher"
    },
    "portable": {
      "artifactName": "Nexus-Launcher-Portable-${version}-${arch}.${ext}"
    }
  }
}
