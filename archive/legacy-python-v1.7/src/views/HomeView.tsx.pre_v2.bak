import React from 'react';
import { Game, LauncherSettings, PlaySession, ViewType } from '../types/game';
import { tr } from '../services/i18n';
import { HeroBanner } from '../components/HeroBanner';
import { GameRail } from '../components/GameRail';
import { Dashboard } from '../components/Dashboard';
import { FolderPlus, ScanSearch, Sparkles } from '../components/UiIcon';

interface HomeViewProps {
  games: Game[];
  sessions: PlaySession[];
  selectedGame: Game | null;
  onSelectGame: (id: string) => void;
  onLaunchGame: (id: string) => void;
  onOpenDetails: () => void;
  onToggleFavorite: (id: string) => void;
  onNavigate: (view: ViewType) => void;
  onAddGame: () => void;
  ambientMotion: boolean;
  language?: LauncherSettings['language'];
}

export const HomeView: React.FC<HomeViewProps> = ({
  games,
  sessions,
  selectedGame,
  onSelectGame,
  onLaunchGame,
  onOpenDetails,
  onToggleFavorite,
  onNavigate,
  onAddGame,
  ambientMotion,
  language,
}) => {
  if (!selectedGame) {
    return (
      <div id="nexus-home-empty" className="relative flex min-h-full items-center justify-center overflow-hidden px-10 pb-16 pt-24">
        <div className="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_58%_42%,rgba(54,144,205,.14),transparent_33%),radial-gradient(circle_at_36%_58%,rgba(229,190,95,.08),transparent_30%)]" />
        <div className="relative max-w-[720px] text-center">
          <div className="mx-auto grid h-16 w-16 place-items-center rounded-[22px] border border-sky-300/20 bg-sky-400/[0.065] text-sky-200 shadow-[0_0_60px_rgba(56,189,248,.08)]">
            <Sparkles className="h-7 w-7" />
          </div>
          <div className="mt-6 text-[9px] font-black uppercase tracking-[.35em] text-sky-300/70">{tr(language, 'ready')}</div>
          <h1 className="mt-2 text-4xl font-black tracking-tight text-white">{tr(language, 'buildLibrary')}</h1>
          <p className="mx-auto mt-3 max-w-xl text-[11.5px] leading-6 text-slate-400">
            {tr(language, 'emptyDescription')}
          </p>
          <div className="mt-7 flex items-center justify-center gap-3">
            <button onClick={onAddGame} className="flex h-11 items-center gap-2 rounded-xl bg-white px-5 text-[11px] font-black text-slate-950 shadow-[0_12px_45px_rgba(255,255,255,.08)] transition hover:-translate-y-0.5">
              <FolderPlus className="h-4 w-4" /> {tr(language, 'addGame')}
            </button>
            <button onClick={onAddGame} className="flex h-11 items-center gap-2 rounded-xl border border-white/[0.1] bg-white/[0.04] px-5 text-[11px] font-bold text-slate-200 transition hover:bg-white/[0.08]">
              <ScanSearch className="h-4 w-4 text-sky-300" /> {tr(language, 'scanLaunchers')}
            </button>
          </div>
        </div>
      </div>
    );
  }

  return (
    <div id="nexus-home-view" className="relative min-h-full pb-16">
      <HeroBanner
        game={selectedGame}
        onLaunch={() => onLaunchGame(selectedGame.id)}
        onOpenDetails={onOpenDetails}
        onToggleFavorite={() => onToggleFavorite(selectedGame.id)}
        ambientMotion={ambientMotion}
      />

      <div className="relative z-20 -mt-[82px] space-y-3.5 px-7">
        <GameRail
          games={games}
          selectedGameId={selectedGame.id}
          onSelectGame={onSelectGame}
          onLaunchGame={onLaunchGame}
        />
        <Dashboard
          games={games}
          sessions={sessions}
          onNavigate={onNavigate}
          onSelectGame={onSelectGame}
        />
      </div>
    </div>
  );
};
