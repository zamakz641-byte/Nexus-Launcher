{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nexus Sound Pack",
  "type": "object",
  "required": ["schema", "id", "name", "author", "version", "type", "license", "cues"],
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
    "name": { "type": "string" },
    "author": { "type": "string" },
    "version": { "type": "string" },
    "type": { "const": "soundpack" },
    "license": { "type": "string" },
    "description": { "type": "string" },
    "cues": {
      "type": "object",
      "required": ["focus", "confirm", "back", "launch", "success", "toggle", "hover", "wake", "sleep", "startup"]
    }
  }
}
